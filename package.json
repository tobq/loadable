{
  "name": "@tobq/loadable",
  "version": "2.1.0",
  "description": "A library for simplifying asynchronous operations in React",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "release": "git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tobq/loadable.git"
  },
  "author": "Tobi Akinyemi",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/tobq/loadable/issues"
  },
  "homepage": "https://github.com/tobq/loadable#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@types/react": "^18.2.0 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "async",
    "loadable",
    "suspense",
    "React",
    "Hooks",
    "Data Loading",
    "Asynchronous",
    "Loadable",
    "TypeScript",
    "State Management",
    "Data Fetching",
    "React Components",
    "Async/Await",
    "Loading State",
    "Error Handling"
  ]
}
